_ruby-build_definitions() {
  local -a definitions=(${(f)"$(_call_program subcommands ruby-build --definitions)"})
  _values 'definition' $definitions
}

_arguments -s \
  '(- *)'{-h,--help}'[Show help message]' \
  '(- *)--version[Show version of ruby-build]' \
  '(- *)'{-l,--list}'[List latest stable releases for each Ruby]' \
  '(- *)--definitions[List all local definitions, includeing outdated ones]' \
  '(- *)--resolve[Print the latest stable definition name matching a version prefix]:version' \
  '(-d --dir)'{-d,--dir}'[Install the Ruby in <prefix>/<definition> instead of <prefix>]' \
  '(-v --verbose)'{-v,--verbose}'[Verbose mode]' \
  '(-p --patch)'{-p,--patch}'[Apply a patch from stdin before building]' \
  '(-k --keep)'{-k,--keep}'[Do not remove source tree after installation]' \
  '(-4 --ipv4)'{-4,--ipv4}'[Resolve names to IPv4 addresses only]' \
  '(-6 --ipv6)'{-6,--ipv6}'[Resolve names to IPv6 addresses only]' \
  '1: :_ruby-build_definitions' \
  '2:dir:_files -/' \
  '*::configure_options'

