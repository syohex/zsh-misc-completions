(( $+functions[_android_sdk] )) ||
_android_sdk() {
  local ret=1

  local -a commands=(
    'install:Install SDK packages'
    'update:Update one or all packages to the latest version'
    'remove:Remove packages from the SDK'
    'list:List installed and available SDK packages'
  )

  _arguments -C \
    '1: :(($commands))' \
    '*:: :->subcmd' && ret=0

  case $state in
    (subcmd)
      case $words[1] in
        (install|update)
          _arguments \
            '--beta[Include beta pacakges]' \
            '--canary[Include canary packages]' \
            '--force[Force downgrading to an older version]' \
            '--platform[Target platform <os>_<arch>]:os_arch' \
            '*:pacakge' \
            && ret=0
          ;;
        (remove)
          _arguments \
            '*:pacakge' \
            && ret=0
          ;;
        (list)
          _arguments \
            '--all[Show all pacakges available in the repository]' \
            '--all-versions[Show all versions for each package]' \
            '--beta[Include beta pacakges]' \
            '--canary[Include canary packages]' \
            '*:filter' \
            && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

(( $+functions[_android_skills] )) ||
_android_skills() {
  local ret=1

  local -a commands=(
    'add:Install a specific skill by its ID to your environment'
    'remove:Remove an installed skill by its ID'
    'list:List installed and available skills'
    'find:Search for available skills in the repository matching a keyword'
  )

  _arguments -C \
    '(- *)'{-h,--help}'[Show help and usage information]' \
    '1: :(($commands))' \
    '*:: :->subcmd' && ret=0

  case $state in
    (subcmd)
      case $words[1] in
        (add)
          _arguments \
            '(- *)'{-h,--help}'[Show help and usage information]' \
            '--agent=[Comma-separated list of agents to install the skill for]' \
            '--all[Install all skills]' \
            '--project=[Path to a project root in which to install]' \
            && ret=0
          ;;
        (remove)
          _arguments \
            '(- *)'{-h,--help}'[Show help and usage information]' \
            '--agent=[Comma-separated list of agents to install the skill for]' \
            '--project=[Path to a project root in which to install]' \
            && ret=0
          ;;
        (list)
          _arguments \
            '(- *)'{-h,--help}'[Show help and usage information]' \
            '--long[Use long output format]' \
            '--project=[Path to a project root in which to install]' \
            && ret=0
          ;;
        (find)
          _arguments \
            '(- *)'{-h,--help}'[Show help and usage information]' \
            '*:keyword' \
            && ret=0
