      esac
      ;;
  esac

  return ret
}

(( $+functions[_android_studio] )) ||
_android_studio() {
  local ret=1

  local -a commands=(
    'find-declaration:Find declaration of a symbol'
    'find-usages:Find usages of a symbol'
    'open-file:Open a file in Android Studio'
    'check:Check the status of running Studio instances'
    'analyze-file:Analyze a file in Android Studio'
    'render-compose-preview:Render a Compose preview in Android Studio'
    'version-lookup:Looks up the latest available versions on the internet'
  )

  _arguments -C \
    '(- *)'{-h,--help}'[Show help and usage information]' \
    '1: :(($commands))' \
    '*:: :->subcmd' && ret=0

  case $state in
    (subcmd)
      local -a options=(
        '(- *)'{-h,--help}'[Show help and usage information]'
      )
      case $words[1] in
        (find-declaration|find-usage|open-file|analyze-file|render-compose-preview|version-lookup)
          options+=(
            '--pid=[PID of the Android Studio instance to connect to]:pid:_pids'
            '--project=[Name or path of the project open in Android Studio to query]:name_or_path:_files'
          )
          ;|
        (find-declaration|find-usage)
          options+=(
            '--short=[Only show the location in files with matches]'
          )
          ;|
        (find-declaration)
          options+=(
            '--context-file=[Optional path to a file containing a reference to the symbol]:path:_files'
          )
          ;;
        (render-compose-preview)
          options+=(
            '--output-image-file=[File name to write the resulting image to]:file:_files'
            '--print-semantics[Print out the semantics tree]'
          )
          ;;
        (version-lookup)
          options+=(
            '*:artifacts:_android_artifacts'
          )
          ;;
      esac

      _arguments $options[@] && ret=0
      ;;
  esac

  return ret
}

# Utilities
(( $+functions[_android_emulator_profiles] )) ||
_android_emulator_profiles() {
  local -a profiles=($(android emulator create --list-profiles))
  _values profiles $profiles
}

(( $+functions[_android_emulator_list] )) ||
_android_emulator_list() {
  local -a emulators=($(android emulator list))
  _values emulators $emulators
}

(( $+functions[_android_artifacts] )) ||
_android_artifacts() {
  local -a artifacts=(
    gradle studio agp ndk sdk emulator adb compose kotlin android
    platform-tools cmdline-tools build-tools
  )
  _values artifacts $artifacts
}

_android "$@"

