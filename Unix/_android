#
# ------------------------------------------------------------------------------

_android() {
  local context state state_descr line
  typeset -A opt_args
  local ret=1

  _arguments -C \
    '(- *)'{-h,--help}'[Show help message and exit]' \
    '--sdk[Path to the Android SDK]:path:_files -/' \
    '(-v --verbose)'{-v,--verbose}'[Enable verbose output for troubleshooting]' \
    '(- *)'{-V,--version}'[Print version information and exit]' \
    '1: :_android_commands' \
    '*:: :->subcmd' && ret=0

  case $state in
    (subcmd)
      case $words[1] in
        (create)
          _arguments \
            '(- *)'{-h,--help}'[Show help message and exit]' \
            '--minSdk=["minSdk" supported by the application]' \
            '--name=[Name of the application]' \
            '(-o --output)'{-o,--output}'[Destination project directory path(default ".")]:path:_files -/' \
            '--verbose[Enables verbose output]' \
            '--list[List all available templates]' \
            '*:template_name' \
            && ret=0
          ;;
        (describe)
          _arguments \
            '(- *)'{-h,--help}'[Show help message and exit]' \
            '--project_dir=[Project directory to describe]:param' \
            '(- *)'{-V,--version}'[Print version information and exit]' \
            && ret=0
          ;;
        (docs)
          _android_docs && ret=0
          ;;
        (emulator)
          _android_emulator && ret=0
          ;;
        (install)
          _arguments \
            '(- *)'{-h,--help}'[Show help message and exit]' \
            '--apks[Paths to the APKs]:apk:_files' \
            '--device=[Device serial number]:device' \
            '--install-options=[Additional options/flags to pass to package manager install]:options' \
            '--use-delta-install[Use fast delta install]' \
            '(-v --verbose)'{-v,--verbose}'[Enable verbose logging]' \
            && ret=0
          ;;
        (layout)
          _arguments \
            '(- *)'{-h,--help}'[Show help message and exit]' \
            '(-d --diff)'{-d,--diff}'[Return a flat list of the layout elements]' \
            '--device=[Device serial number]:serial' \
            '(-o --output)'{-o,--output=}'[Write the layout tree to the specified file or directory]:path:_files' \
            '(-p --pretty)'{-p,--pretty}'[Pretty-prints the returned JSON]' \
            && ret=0
          ;;
        (run)
          _arguments \
            '(- *)'{-h,--help}'[Show help message and exit]' \
            '--activity=[Activity name]' \
            '--apks=[Paths to the APKs]:paths:_files' \
            '--debug[Run in debug mode]' \
            '--device=[Device serial number]' \
            '--install-options=[Additional options/flags to pass to package manager install]:params' \
            '--type=[Component type]:type:(ACTIVITY WATCH_FACE TILE COMPLICATION DECLARATIVE_WATCH_FACE WEAR_WIDGET)' \
            '--use-delta-install[Use fast delta install]' \
            '(-v --verbose)'{-v,--verbose}'[Enable verbose logging]' \
            && ret=0
          ;;
        (screen)
          _android_screen && ret=0
          ;;
        (sdk)
          _android_sdk && ret=0
          ;;
        (skills)
          _android_skills && ret=0
          ;;
        (studio)
          _android_studio && ret=0
          ;;
        (update)
          _arguments \
            '(- *)'{-h,--help}'[Show help message and exit]' \
            '--url=[URL to download the update from]' \
            && ret=0
          ;;
        (*)
          _arguments \
            '(- *)'{-h,--help}'[Display help for command]' \
            && ret=0
          ;;
      esac
    ;;
  esac

  return ret
}

(( $+functions[_android_commands] )) ||
_android_commands() {
  local -a commands=(
    'create:Create a new Android project from available templates'
    'describe:Analyzes an Android project to generate descriptive metadata'
    'docs:Android documentation commands for searching and fetching developer documentation'
    'emulator:Manage Android Virtual Devices (AVDs)'
    'help:Shows the help of all commands'
    'info:Print environment information(SDK location, connected devices, configuration variables)'
    'init:Initializes the environment for the Android CLI'
    'install:Install an Android Application (one or more APKs) to a connected device or emulator'
    'layout:Returns the layout tree of an application'
    'run:Build, deploy, and launch an Android application on a connected device or emulator'
    'screen:Commands to view the device'
    'sdk:Manage the Android SDK installation'
    'skills:Manage Android CLI skills'
    'studio:Android Studio commands'
    'update:Update the Android CLI to the latest version'
  )

  _describe -t 'commands' "commands" commands
}

(( $+functions[_android_docs] )) ||
_android_docs() {
  local ret=1

  local -a commands=(
    'search:Search Android documentation'
    'fetch:Fetch an Android documentation article from a URL(kb://...)'
  )

  _arguments -C \
    '(- *)'{-h,--help}'[Show help message and exit]' \
    '1: :(($commands))' \
    '*:: :->subcmd' && ret=0

  case $state in
    (subcmd)
      case $words[1] in
        (search)
          _arguments \
            '(- *)'{-h,--help}'[Show help message and exit]' \
            '*:query' \
            && ret=0
          ;;
        (fetch)
          _arguments \
            '(- *)'{-h,--help}'[Show help message and exit]' \
            '*:url' \
            && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

(( $+functions[_android_emulator] )) ||
_android_emulator() {
  local ret=1

  local -a commands=(
    'create:Creates a virtual device'
    'start:Launches the specified virtual device'
    'stop:Stops the specified virtual device'
    'list:Lists available virtual devices'
    'remove:Delete a virtual device'
  )

  _arguments -C \
    '(- *)'{-h,--help}'[Show help message and exit]' \
    '1: :(($commands))' \
    '*:: :->subcmd' && ret=0

  case $state in
    (subcmd)
      case $words[1] in
        (create)
          _arguments \
            '(- *)'{-h,--help}'[Show help message and exit]' \
            '--list-profiles[List the device profiles]' \
            '*:profile:_android_emulator_profiles' \
            && ret=0
          ;;
        (start)
          _arguments \
            '(- *)'{-h,--help}'[Display help for this command]' \
            '--cold[Start the emulator without loading from a snapshot]' \
            '*:device:_android_emulator_list' \
            && ret=0
          ;;
        (stop)
          _arguments \
            '(- *)'{-h,--help}'[Display help for this command]' \
            '*:device:_android_emulator_list' \
            && ret=0
          ;;
        (list)
          _arguments \
            '(- *)'{-h,--help}'[Display help for this command]' \
            '--long[Give more detailed information]' \
            && ret=0
          ;;
        (remove)
          _arguments \
            '(- *)'{-h,--help}'[Display help for this command]' \
            '--force[Force removal of .ini file]' \
            '(- *)'{-V,--version}'[Print version information and exit]' \
            && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

